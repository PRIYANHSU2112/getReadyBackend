# =============================================================================
# GET READY BACKEND — PRODUCTION TEMPLATE (.env.production.example)
# DO NOT COMMIT REAL PRODUCTION SECRETS TO GIT.
# Inject these environment variables through your deployment secret manager
# (e.g. Docker Secrets, Doppler, HashiCorp Vault, AWS Secrets Manager, GitHub Secrets).
# =============================================================================

NODE_ENV=production
PORT=3000
GATEWAY_PORT=3000
APP_NAME=getready-api-gateway
APP_URL=https://api.getready.example.com

# Swagger UI (Disabled in Production)
SWAGGER_ENABLED=false

# Production MongoDB Atlas Cluster (External managed database)
# Example: mongodb+srv://<PROD_USER>:<PROD_PASSWORD>@<PROD_CLUSTER>.mongodb.net/getready_prod?retryWrites=true&w=majority&appName=Cluster0
DATABASE_URI=

# Microservices URLs (Internal cluster / Docker network DNS)
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
BEAUTICIAN_SERVICE_URL=http://beautician-service:3003
CATALOG_SERVICE_URL=http://catalog-service:3004
BOOKING_SERVICE_URL=http://booking-service:3005
CART_SERVICE_URL=http://cart-service:3006
PAYMENT_SERVICE_URL=http://payment-service:3007
WALLET_SERVICE_URL=http://wallet-service:3008
NOTIFICATION_SERVICE_URL=http://notification-service:3009
CONTENT_SERVICE_URL=http://content-service:3010
WORKER_SERVICE_URL=http://worker-service:3011

# RabbitMQ Credentials (Internal container)
RABBITMQ_USER=getready_prod_admin
RABBITMQ_PASS=your_strong_cryptographic_rabbitmq_password_2026
RABBITMQ_URL=amqp://getready_prod_admin:your_strong_cryptographic_rabbitmq_password_2026@rabbitmq:5672

# Production Redis (Internal container with password protection)
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_strong_cryptographic_redis_password_2026

# Observability Credentials (Grafana)
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_strong_grafana_admin_password_2026

# JWT Secrets (Must be unique, cryptographically random, min 32 chars)
JWT_SECRET=your_production_jwt_secret_min_32_characters_here_2026
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_min_32_characters_2026
JWT_REFRESH_EXPIRES_IN=7d
JWT_ACCESS_EXPIRATION_MINUTES=60

# CORS Allowed Production Domains (Comma-separated, never wildcard *)
CORS_ORIGINS=https://admin.getready.example.com,https://www.getready.example.com

# Logging & Monitoring (Standardized for Production Loki / Prometheus)
LOG_LEVEL=info
METRICS_ENABLED=true
OTEL_ENABLED=true
OTEL_SERVICE_NAME=getready-production-api

# OTP & Production SMS Provider (e.g. twilio, kaleyra, msg91)
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS_PER_HOUR=3
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Production Object Storage (Dedicated production bucket: DigitalOcean Spaces, S3, MinIO)
AWS_REGION=sgp1
AWS_BUCKET_NAME=getready-production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
BUCKET_FOLDER_PATH=uploads/production/
S3_PUBLIC_READ=true

# Live Razorpay Credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AES-256 Production Encryption Key
SETTINGS_ENCRYPTION_KEY=

# Production Firebase Push Notifications
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
