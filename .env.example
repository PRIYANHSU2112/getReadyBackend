# =============================================================================
# GET READY BACKEND — BASE EXAMPLE CONFIGURATION (.env.example)
# =============================================================================
NODE_ENV=development
PORT=3000
GATEWAY_PORT=3000
APP_NAME=getready-api
APP_URL=http://localhost:3000

# Swagger
SWAGGER_ENABLED=true

# Database (MongoDB Atlas Cloud Cluster)
DATABASE_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/getready_dev?retryWrites=true&w=majority&appName=Cluster0

# Microservices URLs
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
BEAUTICIAN_SERVICE_URL=http://localhost:3003
CATALOG_SERVICE_URL=http://localhost:3004
BOOKING_SERVICE_URL=http://localhost:3005
CART_SERVICE_URL=http://localhost:3006
PAYMENT_SERVICE_URL=http://localhost:3007
WALLET_SERVICE_URL=http://localhost:3008
NOTIFICATION_SERVICE_URL=http://localhost:3009
CONTENT_SERVICE_URL=http://localhost:3010
WORKER_SERVICE_URL=http://localhost:3011

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Redis
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Development default — override in production)
JWT_SECRET=getready_dev_super_secret_jwt_key_2026_at_least_32_characters
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=getready_dev_super_secret_jwt_refresh_key_2026_at_least_32
JWT_REFRESH_EXPIRES_IN=7d
JWT_ACCESS_EXPIRATION_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging & Monitoring
LOG_LEVEL=debug
METRICS_ENABLED=true
OTEL_ENABLED=false

# OTP / SMS
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
SMS_PROVIDER=console

# Storage
AWS_REGION=sgp1
AWS_BUCKET_NAME=getready-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BUCKET_FOLDER_PATH=uploads/dev/

# Razorpay Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Seed Super Admin
SUPER_ADMIN_NAME=GetReady Super Admin
SUPER_ADMIN_EMAIL=admin@getready.com
SUPER_ADMIN_PASSWORD=Admin@123
