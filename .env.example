# Application
NODE_ENV=development
PORT=3000
APP_NAME=salon-api
APP_URL=http://localhost:3000
# Keep APP_URL in sync with PORT (Swagger "Try it out" uses APP_URL).
# Optional: force Swagger on/off (overrides env presets). Useful when NODE_ENV=production locally.
# SWAGGER_ENABLED=true

# MongoDB (prefer Atlas in Docker/production)
# Local example: mongodb://localhost:27017/salon
# Atlas example: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/Salon?retryWrites=true&w=majority
DATABASE_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/Salon?retryWrites=true&w=majority
MONGODB_URI=

# Redis — cache, OTP, and BullMQ queues (Docker Compose overrides REDIS_HOST=redis)
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# OTP
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_RESENDS_PER_HOUR=3
SMS_PROVIDER=console

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=1d

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Storage — S3 only (AWS_BUCKET_NAME or LINODE_* fallbacks)
AWS_REGION=sgp1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
# Optional S3-compatible endpoint (DigitalOcean Spaces / Linode):
# AWS_S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
BUCKET_FOLDER_PATH=uploads/
S3_PUBLIC_READ=true

# Logging
LOG_LEVEL=info

# Monitoring
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=salon-api
