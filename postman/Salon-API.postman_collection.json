              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Requires Bearer JWT. Collection auth uses {{accessToken}} (auto-set after login)."
          },
          "response": []
        }
      ]
    },
