# =============================================================================
# GET READY BACKEND — DEVELOPMENT ENVIRONMENT (.env.development)
# =============================================================================
NODE_ENV=development
PORT=3000
GATEWAY_PORT=3000
APP_NAME=getready-api-dev
APP_URL=http://localhost:3000

# Swagger / OpenAPI Documentation (Enabled in Development)
SWAGGER_ENABLED=true

# Database (MongoDB Atlas Cloud Cluster)
DATABASE_URI=mongodb+srv://techservlet876_db_user:HzOQzzmvlaajvz8O@cluster0.q5gfuwd.mongodb.net/getready_dev?retryWrites=true&w=majority&appName=Cluster0

# Microservices URLs (Local ports)
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
BEAUTICIAN_SERVICE_URL=http://localhost:3003
CATALOG_SERVICE_URL=http://localhost:3004
BOOKING_SERVICE_URL=http://localhost:3005
CART_SERVICE_URL=http://localhost:3006
PAYMENT_SERVICE_URL=http://localhost:3007
WALLET_SERVICE_URL=http://localhost:3008
NOTIFICATION_SERVICE_URL=http://localhost:3009
CONTENT_SERVICE_URL=http://localhost:3010
WORKER_SERVICE_URL=http://localhost:3011

# RabbitMQ Event Bus (Development instance)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Redis (Cache, OTP & Queues)
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication (Development Secret)
JWT_SECRET=getready_dev_super_secret_jwt_key_2026_at_least_32_characters
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=getready_dev_super_secret_jwt_refresh_key_2026_at_least_32
JWT_REFRESH_EXPIRES_IN=7d
JWT_ACCESS_EXPIRATION_MINUTES=60

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5000,http://localhost:8080

# Logging & Monitoring
LOG_LEVEL=debug
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=getready-api-dev

# OTP & SMS (Console provider prints OTP to stdout for local debugging)
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_RESENDS_PER_HOUR=5
SMS_PROVIDER=console

