{
  "name": "getready-backend-microservices",
  "version": "2.0.0",
  "description": "GetReady Production-Ready Microservices Architecture",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "start": "npm run start:gateway",
    "start:gateway": "node services/api-gateway/src/server.js",
    "start:auth": "node services/auth-service/src/server.js",
    "start:user": "node services/user-service/src/server.js",
    "start:beautician": "node services/beautician-service/src/server.js",
    "start:catalog": "node services/catalog-service/src/server.js",
    "start:booking": "node services/booking-service/src/server.js",
    "start:cart": "node services/cart-service/src/server.js",
    "start:payment": "node services/payment-service/src/server.js",
    "start:wallet": "node services/wallet-service/src/server.js",
    "start:notification": "node services/notification-service/src/server.js",
    "start:content": "node services/content-service/src/server.js",
    "start:worker": "node services/worker-service/src/server.js",
    "dev:gateway": "node --watch services/api-gateway/src/server.js",
    "dev:auth": "node --watch services/auth-service/src/server.js",
    "dev:user": "node --watch services/user-service/src/server.js",
    "dev:beautician": "node --watch services/beautician-service/src/server.js",
    "dev:catalog": "node --watch services/catalog-service/src/server.js",
    "dev:booking": "node --watch services/booking-service/src/server.js",
    "dev:cart": "node --watch services/cart-service/src/server.js",
    "dev:payment": "node --watch services/payment-service/src/server.js",
    "dev:wallet": "node --watch services/wallet-service/src/server.js",
    "dev:notification": "node --watch services/notification-service/src/server.js",
    "dev:content": "node --watch services/content-service/src/server.js",
    "dev:worker": "node --watch services/worker-service/src/server.js",
    "seed:rbac": "node scripts/seed-rbac.js",
    "seed:super-admin": "node scripts/seed-super-admin.js",
    "migrate:user-role": "node scripts/migrate-user-role.js",
    "dev": "npm run start:gateway",
    "start:prod": "NODE_ENV=production node services/api-gateway/src/server.js",
    "validate:env": "node scripts/validate-env.js",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker-compose.dev.yml down",
    "docker:build": "docker compose -f docker-compose.dev.yml build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch --runInBand",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand",
    "lint": "eslint packages/ services/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "amqplib": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-http-proxy": "^2.1.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.4.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.3",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "razorpay": "^2.9.8",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.3",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0"
  }
}
