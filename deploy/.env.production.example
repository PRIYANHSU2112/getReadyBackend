# =============================================================================
# GET READY BACKEND — AWS PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# Region: ap-south-1 (Mumbai)
# EC2 Instance: i-0a4e7008ca42520d2 (getReady-backend)
# ECR Registry: 154458646293.dkr.ecr.ap-south-1.amazonaws.com/getready-backend
# 
# DO NOT COMMIT REAL PRODUCTION SECRETS TO GIT.
# Copy this file to .env.production on EC2 (/opt/getready/.env.production).
# =============================================================================

# Deployment & Image Version
IMAGE_TAG=
ECR_REGISTRY=154458646293.dkr.ecr.ap-south-1.amazonaws.com/getready-backend

# Application Runtime
NODE_ENV=production
PORT=3000
GATEWAY_PORT=3000
APP_NAME=getready-api-gateway
APP_URL=https://api.getready.example.com
SWAGGER_ENABLED=false

# Production MongoDB Atlas Cluster (REQUIRED — External Managed Database)
# Example: mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/getready_prod?retryWrites=true&w=majority
DATABASE_URI=

# Microservices URLs (Internal Docker Network DNS)
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
BEAUTICIAN_SERVICE_URL=http://beautician-service:3003
CATALOG_SERVICE_URL=http://catalog-service:3004
BOOKING_SERVICE_URL=http://booking-service:3005
CART_SERVICE_URL=http://cart-service:3006
PAYMENT_SERVICE_URL=http://payment-service:3007
WALLET_SERVICE_URL=http://wallet-service:3008
NOTIFICATION_SERVICE_URL=http://notification-service:3009
CONTENT_SERVICE_URL=http://content-service:3010
WORKER_SERVICE_URL=http://worker-service:3011

# Internal Redis Configuration
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Internal RabbitMQ Configuration
RABBITMQ_USER=admin
RABBITMQ_PASS=
RABBITMQ_URL=

# Internal Observability (Grafana)
GRAFANA_USER=admin
GRAFANA_PASSWORD=

# Security & JWT (Must be unique, cryptographically random string >= 32 characters)
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
JWT_ACCESS_EXPIRATION_MINUTES=60

# CORS Allowed Origins (Comma-separated, no wildcard * allowed in production)
CORS_ORIGINS=https://admin.getready.example.com,https://www.getready.example.com

# Logging & Monitoring
LOG_LEVEL=info
METRICS_ENABLED=true
OTEL_ENABLED=false

# OTP Configuration & SMS Provider (twilio / console / msg91)
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_RESENDS_PER_HOUR=3
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Object Storage (DigitalOcean Spaces / S3)
AWS_REGION=sgp1
AWS_BUCKET_NAME=getready-production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
BUCKET_FOLDER_PATH=uploads/production/

# Razorpay Payment Gateway (Live credentials)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase Cloud Messaging / Push Notifications
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
